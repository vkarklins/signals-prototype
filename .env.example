# Copy to .env (git ignores it) and fill in.

# Laminar (self-hosted): project API key from the Laminar UI, Settings -> Project API Keys.
# Use a "Default" key: sync needs read access to the SQL API.
LMNR_PROJECT_API_KEY=...
LMNR_BASE_URL=http://localhost
LMNR_HTTP_PORT=8000

# Our Postgres database (the one schema.sql was applied to; not Laminar's on 5433).
# Postgres's standard variables, read automatically by psycopg:
PGUSER=...
PGPASSWORD=...
PGHOST=localhost
PGPORT=5432
PGDATABASE=signals
# Or instead, one URL (wins over the variables above for the parts it contains):
# DATABASE_URL=postgresql://user:password@localhost:5432/signals

# Optional sync settings (defaults shown).
# SYNC_INTERVAL_SECONDS=10
# SYNC_SETTLE_SECONDS=15
# SYNC_FIRST_RUN_LOOKBACK_HOURS=24

# Only for running the sync tests: a database the tests may create throwaway schemas in.
# They drop their schemas afterwards. An empty URL also works: it uses the PG* variables.
TEST_DATABASE_URL=postgresql://
