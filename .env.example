# Copy to .env (git ignores it) and fill in.

# --- Our Postgres (turns + results). `docker compose up -d --wait db` runs it and
# creates the tables from schema.sql. Not Laminar's own Postgres.
POSTGRES_PASSWORD=local_dev_password
DATABASE_URL=postgresql://signals:local_dev_password@localhost:5433/signals_prototype
# Sync also accepts Postgres's standard PGUSER/PGPASSWORD/PGHOST/PGPORT/PGDATABASE
# variables; DATABASE_URL wins for the parts it contains.

# --- Track B: classifier
OPENAI_API_KEY=your-api-key

# --- Track A: sync from Laminar (self-hosted). Project API key from the Laminar UI,
# Settings -> Project API Keys. Use a "Default" key: sync needs read access to the SQL API.
LMNR_PROJECT_API_KEY=...
LMNR_BASE_URL=http://localhost
LMNR_HTTP_PORT=8000
# Optional sync settings (defaults shown).
# SYNC_INTERVAL_SECONDS=10
# SYNC_SETTLE_SECONDS=15
# SYNC_FIRST_RUN_LOOKBACK_HOURS=24

# --- Tests. Both test suites create throwaway schemas here and drop them afterwards.
# Optional: create this database separately to run integration checks.
# TEST_DATABASE_URL=postgresql://signals:local_dev_password@localhost:5433/signals_prototype_test
